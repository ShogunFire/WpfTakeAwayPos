<UserControl x:Class="RestaurantPOS.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:RestaurantPOS.Views"
             xmlns:controls="clr-namespace:RestaurantPOS.Views.Controls"
             xmlns:converters="clr-namespace:RestaurantPOS.Resources.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource PageBackground}"
             Foreground="{DynamicResource TextBlack}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InventoryQuantityConverter x:Key="InventoryQuantityConverter"/>
        
        <!-- Keypad Input Target Style -->
        <Style x:Key="KeypadInputStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderMediumGray}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{StaticResource BackgroundWhite}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="0" Opacity="0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Menu -->
        <local:BackofficeNavMenu Grid.Column="0"/>

        <!-- Right Content Area -->
        <Border Grid.Column="1"
            Padding="20"
            Visibility="{Binding InventoryModuleEnabled, Source={StaticResource FeatureService}, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="📦 Inventory Management"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBlack}"
                           Margin="0,0,0,16"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding InventoryItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8"
                                        BorderBrush="{StaticResource BorderLightGray}"
                                        BorderThickness="1"
                                        Background="{StaticResource BackgroundWhite}"
                                        Padding="16"
                                        Margin="8"
                                        Width="240">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Bold"
                                                   FontSize="18"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock FontSize="14"
                                                   Foreground="{DynamicResource TextDarkGray}"
                                                   Margin="0,0,0,12">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource InventoryQuantityConverter}">
                                                    <Binding Path="Quantity"/>
                                                    <Binding Path="Unit"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                                <Button Content="Add"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding DataContext.ShowAddPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="100"
                                                    Margin="0,0,8,0"/>
                                                <Button Content="Remove"
                                                    Style="{StaticResource DangerButton}"
                                                    Command="{Binding DataContext.ShowRemovePopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="100"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
