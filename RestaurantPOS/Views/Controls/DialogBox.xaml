<UserControl x:Class="RestaurantPOS.Views.Controls.DialogBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="DialogBoxRoot">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Background="#80000000"
          Visibility="{Binding IsOpen, ElementName=DialogBoxRoot, Converter={StaticResource BoolToVisibility}}">
        <Border Background="{DynamicResource BackgroundWhite}"
                CornerRadius="12"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="600"
                MaxWidth="800">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="{Binding Title, ElementName=DialogBoxRoot}"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,24"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBlack}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Title, ElementName=DialogBoxRoot}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Message -->
                <TextBlock Grid.Row="1"
                           Text="{Binding Message, ElementName=DialogBoxRoot}"
                           FontSize="16"
                           Margin="0,0,0,32"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextDarkGray}"
                           LineHeight="24"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="2"
                            x:Name="ButtonPanel"
                            Orientation="Vertical"
                            >
                    <!-- Alert Mode (Single OK button) -->
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DialogType, ElementName=DialogBoxRoot}" Value="Confirm">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="{Binding ConfirmText, ElementName=DialogBoxRoot}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConfirmCommand, ElementName=DialogBoxRoot}"
                            Height="70"
                            FontSize="18"
                            FontWeight="Bold"/>
                </StackPanel>

                <!-- Confirm Mode (Yes/No buttons) -->
                <Grid Grid.Row="2">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DialogType, ElementName=DialogBoxRoot}" Value="Confirm">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="{Binding CancelText, ElementName=DialogBoxRoot}"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding CancelCommand, ElementName=DialogBoxRoot}"
                            Height="70"
                            FontSize="18"
                            FontWeight="Bold"
                            Margin="0,0,6,0"/>
                    <Button Grid.Column="1"
                            Content="{Binding ConfirmText, ElementName=DialogBoxRoot}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConfirmCommand, ElementName=DialogBoxRoot}"
                            Height="70"
                            FontSize="18"
                            FontWeight="Bold"
                            Margin="6,0,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
