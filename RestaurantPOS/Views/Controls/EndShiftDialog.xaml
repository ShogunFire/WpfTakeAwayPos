<UserControl x:Class="RestaurantPOS.Views.Controls.EndShiftDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantPOS.Views.Controls"
             x:Name="EndShiftDialogRoot">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Background="#80000000"
          Visibility="{Binding IsDialogOpen, ElementName=EndShiftDialogRoot, Converter={StaticResource BoolToVisibility}}">
        <Border Background="{DynamicResource BackgroundWhite}"
                CornerRadius="12"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="600"
                MaxWidth="800">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="🏁 End Shift - Count Cash"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,24"
                           Foreground="{DynamicResource TextBlack}"/>

                <!-- Keypad -->
                <StackPanel Grid.Row="1" Margin="0,0,0,32">
                    <TextBlock Text="Enter Counted Amount" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"
                               Foreground="{DynamicResource TextDarkGray}"/>
                    <controls:KeypadControl UnitLabel="$"
                                            IsPrefix="True"
                                            Value="{Binding KeypadValue, ElementName=EndShiftDialogRoot}"/>
                </StackPanel>

                <!-- Summary Cards -->
                <Grid Grid.Row="2" Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Expected Cash -->
                    <Border Grid.Column="0" Background="{DynamicResource BackgroundGray}" Padding="16" CornerRadius="8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Expected" FontSize="12" Foreground="{DynamicResource TextDarkGray}"/>
                            <TextBlock Text="{Binding ExpectedCash, ElementName=EndShiftDialogRoot, StringFormat=C}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBlack}"/>
                        </StackPanel>
                    </Border>

                    <!-- Cash Counted -->
                    <Border Grid.Column="1" Background="{DynamicResource BackgroundGray}" Padding="16" CornerRadius="8" Margin="8,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Counted" FontSize="12" Foreground="{DynamicResource TextDarkGray}"/>
                            <TextBlock Text="{Binding CountedCash, ElementName=EndShiftDialogRoot, StringFormat=C}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBlack}"/>
                        </StackPanel>
                    </Border>

                    <!-- Difference -->
                    <Border Grid.Column="2" Background="{DynamicResource BackgroundGray}" Padding="16" CornerRadius="8" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Difference" FontSize="12" Foreground="{DynamicResource TextDarkGray}"/>
                            <TextBlock Text="{Binding Difference, ElementName=EndShiftDialogRoot, StringFormat=C}" FontSize="18" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBlack}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Difference, ElementName=EndShiftDialogRoot, Converter={StaticResource NumberSignConverter}}" Value="Positive">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Difference, ElementName=EndShiftDialogRoot, Converter={StaticResource NumberSignConverter}}" Value="Negative">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Buttons -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Cancel"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding CloseDialogCommand, ElementName=EndShiftDialogRoot}"
                            Height="70"
                            FontSize="18"
                            FontWeight="Bold"
                            Margin="0,0,6,0"/>
                    <Button Grid.Column="1"
                            Content="Submit"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SubmitCommand, ElementName=EndShiftDialogRoot}"
                            Height="70"
                            FontSize="18"
                            FontWeight="Bold"
                            Margin="6,0,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
