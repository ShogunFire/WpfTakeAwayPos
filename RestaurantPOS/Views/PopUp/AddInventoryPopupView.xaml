<UserControl x:Class="RestaurantPOS.Views.AddInventoryPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantPOS.Views.Controls"
             xmlns:converters="clr-namespace:RestaurantPOS.Resources.Converters"
             xmlns:models="clr-namespace:RestaurantPOS.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,16"
                   Foreground="{DynamicResource TextBlack}">
            <TextBlock.Text>
                <MultiBinding StringFormat="Add {0} Inventory">
                    <Binding Path="ActiveInventoryItem.Name"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <!-- Quantity Input -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Quantity -->
            <controls:KeypadInputBox Grid.Column="0"
                                     Label="Quantity"
                                     DisplayValue="{Binding Quantity}"
                                     Target="{x:Static models:KeypadTarget.Quantity}"
                                     ActiveTarget="{Binding ActiveTarget}"
                                     ActivateCommand="{Binding SetTargetCommand}"/>

            <!-- Total Cost (if available) -->
            <controls:KeypadInputBox Grid.Column="2"
                                     Label="Total Cost"
                                     DisplayValue="{Binding TotalCost, StringFormat='C'}"
                                     Target="{x:Static models:KeypadTarget.TotalCost}"
                                     ActiveTarget="{Binding ActiveTarget}"
                                     ActivateCommand="{Binding SetTargetCommand}">
                <controls:KeypadInputBox.Style>
                    <Style TargetType="controls:KeypadInputBox">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InventoryCostModuleEnabled, Source={StaticResource FeatureService}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:KeypadInputBox.Style>
            </controls:KeypadInputBox>
        </Grid>

        <!-- Keypad -->
        <controls:KeypadControl Grid.Row="2"
                                ShowDisplay="False"
                                Value="{Binding KeypadValue, Mode=TwoWay}"
                                Margin="0,0,0,20"/>

        <!-- Paid with Cash Checkbox -->
        <CheckBox Grid.Row="3"
                  Content="Paid with Cash (Creates Expense)"
                  IsChecked="{Binding PaidWithCash}"
                  FontSize="16"
                  Foreground="{DynamicResource TextBlack}"
                  Margin="0,0,0,20"
                  VerticalAlignment="Center">
            <CheckBox.Style>
                <Style TargetType="CheckBox">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding InventoryCostModuleEnabled, Source={StaticResource FeatureService}}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </CheckBox.Style>
        </CheckBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}"
                    Padding="20,15"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Background="{DynamicResource DangerColor}"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Height="70"
                    
                    Margin="0,0,12,0"/>
            <Button Content="Confirm" 
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ConfirmAdjustmentCommand}"
                    Height="70"/>
        </StackPanel>
    </Grid>
</UserControl>
