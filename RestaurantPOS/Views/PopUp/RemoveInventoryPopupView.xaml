<UserControl x:Class="RestaurantPOS.Views.RemoveInventoryPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantPOS.Views.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,16"
                   Foreground="{DynamicResource TextBlack}">
            <TextBlock.Text>
                <MultiBinding StringFormat="Remove {0} Inventory">
                    <Binding Path="ActiveInventoryItem.Name"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <!-- Quantity Input -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Quantity" 
                       FontSize="14" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource TextDarkGray}"/>
            <Border BorderBrush="{DynamicResource BorderMediumGray}" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    Padding="12" 
                    Background="{DynamicResource BackgroundWhite}">
                <TextBlock Text="{Binding Quantity}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBlack}"/>
            </Border>
        </StackPanel>

        <!-- Reason Selection -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Reason for Removal" 
                       FontSize="14" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource TextDarkGray}"/>
            <ListBox ItemsSource="{Binding RemovalReasons}"
                     SelectedItem="{Binding SelectedRemovalReason}"
                     Height="120"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" 
                                   Padding="8"
                                   FontSize="14"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- Keypad -->
        <controls:KeypadControl Grid.Row="3"
                                ShowDisplay="False"
                                Value="{Binding KeypadValue, Mode=TwoWay}"
                                Margin="0,0,0,20"/>

        <!-- Info Panel -->
        <Border Grid.Row="4"
                Background="{DynamicResource BackgroundGray}"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Item Details" 
                           FontSize="12" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDarkGray}"
                           Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Current Stock" FontSize="12" Foreground="{DynamicResource TextDarkGray}"/>
                        <TextBlock Text="{Binding ActiveInventoryItem.Quantity, StringFormat='C'}" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBlack}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Unit" FontSize="12" Foreground="{DynamicResource TextDarkGray}"/>
                        <TextBlock Text="{Binding ActiveInventoryItem.Unit}" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBlack}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}"
                    Padding="20,15"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Background="{DynamicResource DangerColor}"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Height="70"
                    Margin="0,0,12,0"/>
            <Button Content="Confirm Remove" 
                    Style="{StaticResource DangerButton}"
                    Command="{Binding ConfirmAdjustmentCommand}"
                    Height="70"/>
        </StackPanel>
    </Grid>
</UserControl>
