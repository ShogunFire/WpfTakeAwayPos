<UserControl x:Class="RestaurantPOS.Views.EndShiftPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantPOS.Views.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="🏁 End Shift - Count Cash"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,24"
                   Foreground="{DynamicResource TextBlack}"/>

        <!-- Keypad -->
        <StackPanel Grid.Row="1" Margin="0,0,0,32">
            <TextBlock Text="Enter Counted Amount" 
                       FontSize="14" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"
                       Foreground="{DynamicResource TextDarkGray}"/>
            <controls:KeypadControl UnitLabel="$"
                                    IsPrefix="True"
                                    Value="{Binding KeypadValue}"/>
        </StackPanel>

       

        <!-- Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Cancel"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding CancelCommand}"
                    Height="70"
                    FontSize="18"
                    FontWeight="Bold"
                    Margin="0,0,6,0"/>
            <Button Grid.Column="1"
                    Content="Submit"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SubmitCommand}"
                    Height="70"
                    FontSize="18"
                    FontWeight="Bold"
                    Margin="6,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
