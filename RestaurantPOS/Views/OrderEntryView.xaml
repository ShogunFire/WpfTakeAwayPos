<UserControl x:Class="RestaurantPOS.Views.OrderEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Padding="16"
             Background="{DynamicResource PageBackground}"
             Foreground="{DynamicResource TextBlack}">
    <UserControl.Resources>
        <ResourceDictionary>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBlack}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Cursor" Value="Hand"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}">
                                <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PressedOverlay}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="MenuItemCardTemplate">
                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="8" Cursor="Hand"
                        Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        CommandParameter="{Binding}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CardBorder" 
                                    CornerRadius="8" 
                                    BorderBrush="{StaticResource BorderLightGray}" 
                                    BorderThickness="1" 
                                    Padding="15" 
                                    Width="210" 
                                    Height="180" 
                                    Background="{StaticResource BackgroundWhite}">
                                <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource TextBlack}"/>
                                    <TextBlock Text="{Binding Price, StringFormat=C}" FontWeight="Bold" Foreground="{StaticResource PriceBlue}" FontSize="24"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource HoverBackgroundGray}"/>
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource ClickBackgroundBlue}"/>
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="OrderItemTemplate">
                <Border BorderBrush="{StaticResource BorderLightGray}"
                BorderThickness="0,0,0,1"
                Padding="8">

                    <Grid MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"
                                      SharedSizeGroup="ItemNameColumn"/>
                            <ColumnDefinition Width="Auto"
                                      SharedSizeGroup="ActionsColumn"/>
                        </Grid.ColumnDefinitions>

                        <!-- Item info -->
                        <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="0,4,0,4">
                                     <TextBlock Text="{Binding Item.Name}"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                                     <TextBlock Text="{Binding Item.Price, StringFormat=C}"
                               FontSize="12"
                               Foreground="{StaticResource TextDarkGray}"/>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">

                            <Button Content="−"
                            Width="48"
                            Height="48"
                            FontSize="20"
                            Style="{StaticResource IconButton}"
                            Command="{Binding DataContext.DecreaseQtyCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>

                                     <TextBlock Text="{Binding Quantity}"
                               Width="40"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>

                            <Button Content="+"
                            Width="48"
                            Height="48"
                            FontSize="20"
                            Style="{StaticResource IconButton}"
                            Command="{Binding DataContext.IncreaseQtyCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>

                            <Button Content="✕"
                            Width="52"
                            Height="52"
                            Margin="8,0,0,0"
                            FontSize="18"
                            Foreground="{StaticResource DangerColor}"
                            Style="{StaticResource IconButton}"
                            Command="{Binding DataContext.RemoveItemCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

        
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Categories -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">

            <ListBox ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory}"
                 Margin="6"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBlack}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </StackPanel>

        <!-- CENTER: Menu items -->
        <ScrollViewer Grid.Column="1"
              VerticalScrollBarVisibility="Hidden"
              HorizontalScrollBarVisibility="Disabled"
              PanningMode="VerticalOnly"
              PanningDeceleration="0.001"
              IsManipulationEnabled="True">

            <ItemsControl ItemsSource="{Binding FilteredMenuItems}"
                  ItemTemplate="{StaticResource MenuItemCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

        </ScrollViewer>


        <!-- RIGHT: Order summary -->
        <Border Grid.Column="2" CornerRadius="8" BorderBrush="{StaticResource BorderLightGray}" BorderThickness="1" Padding="16" Background="{StaticResource BackgroundWhite}">
            <DockPanel>
                <!-- Bottom section: Totals and Buttons (docked at bottom) -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="0,8,0,8"/>

                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Total:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OrderSession.CurrentOrder.TotalAmount, StringFormat=C}" FontWeight="Bold"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                        <Button Content="Cancel Order" Style="{StaticResource DangerButton}" Command="{Binding CancelOrderCommand}" Width="160"/>
                        <Button Content="Go to Payment" Style="{StaticResource PrimaryButton}" Command="{Binding GoToPaymentCommand}" Width="160"/>
                    </StackPanel>
                </StackPanel>

                <!-- Top section: Order items with scroll -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding OrderSession.CurrentOrder.OrderLines}"
                            ItemTemplate="{StaticResource OrderItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>