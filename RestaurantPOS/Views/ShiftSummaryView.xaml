<UserControl x:Class="RestaurantPOS.Views.ShiftSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:RestaurantPOS.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:ResourceKeyToBrushConverter x:Key="ResourceKeyToBrushConverter"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource PageBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20" VerticalAlignment="Top" HorizontalAlignment="Center" Width="600">
            <!-- Header -->
            <TextBlock Text="Shift Summary" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextMediumGray}" Margin="0,0,0,30" TextAlignment="Center" />

            <!-- Summary Card -->
            <Border Background="{StaticResource BackgroundWhite}" CornerRadius="12" Padding="30" Margin="0,0,0,20" >
                <StackPanel>
                    <!-- Timing Section -->
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Shift Duration" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDarkGray}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start" FontSize="11" Foreground="{StaticResource TextDarkGray}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding StartTime}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMediumGray}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="→" FontSize="16" Foreground="{StaticResource BorderMediumGray}" VerticalAlignment="Center" Margin="15,0"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="End" FontSize="11" Foreground="{StaticResource TextDarkGray}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding EndTime}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMediumGray}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Separator Background="{StaticResource BorderLightGray}" Margin="0,0,0,25"/>

                    <!-- Cash Section -->
                    <TextBlock Text="Cash Management" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDarkGray}" Margin="0,0,0,15"/>
                    
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Opening Float" FontSize="11" Foreground="{StaticResource TextDarkGray}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding OpeningCash, StringFormat='{}{0:C}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InfoColor}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Expected Total" FontSize="11" Foreground="{StaticResource TextDarkGray}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ExpectedCash, StringFormat='{}{0:C}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMediumGray}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Counted Cash" FontSize="11" Foreground="{StaticResource TextDarkGray}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CountedCash, StringFormat='{}{0:C}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMediumGray}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Difference" FontSize="11" Foreground="{StaticResource TextDarkGray}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DifferenceStatus}" FontSize="16" FontWeight="Bold" Foreground="{Binding DifferenceColor, Converter={StaticResource ResourceKeyToBrushConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{StaticResource BorderLightGray}" Margin="0,0,0,25"/>

                    <!-- Activity Section -->
                    <TextBlock Text="Shift Activity" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDarkGray}" Margin="0,0,0,15"/>
                    
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Orders" FontSize="11" Foreground="{StaticResource TextDarkGray}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding OrderCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessColor}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Total Sales" FontSize="11" Foreground="{StaticResource TextDarkGray}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalOrders, StringFormat='{}{0:C}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMediumGray}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Transactions List -->
                    <TextBlock Text="Transactions" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkGray}" Margin="0,0,0,12"/>
                    <Border Background="{StaticResource BackgroundWhite}" CornerRadius="8" Padding="0" MaxHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Transactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderLightGray}" BorderThickness="0,0,0,1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Type}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMediumGray}"/>
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource TextDarkGray}" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding TimeRecorded, StringFormat='{}{0:HH:mm:ss}'}" FontSize="11" Foreground="{StaticResource TextDarkGray}" TextAlignment="Right" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='{}{0:C}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InfoColor}" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Print Receipt Button -->
            <Button Content="Print receipt" 
                    Command="{Binding CloseShiftCommand}"
                    Background="{StaticResource SuccessColor}" 
                    Foreground="White" 
                    FontSize="16" 
                    FontWeight="SemiBold"
                    Padding="20,15"
                    HorizontalAlignment="Stretch"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Resources>
            </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
