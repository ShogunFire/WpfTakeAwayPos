<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Dark Theme Colors -->
    <Color x:Key="ClickBackgroundBlueColor">#1E3A5F</Color>
    <Color x:Key="HoverBackgroundGrayColor">#374151</Color>
    
    <SolidColorBrush x:Key="PageBackground">#111827</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryColor">#3B82F6</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryHoverColor">#2563EB</SolidColorBrush>
    <SolidColorBrush x:Key="DangerColor">#EF4444</SolidColorBrush>
    <SolidColorBrush x:Key="BackgroundWhite">#1F2937</SolidColorBrush>
    <SolidColorBrush x:Key="BorderLightGray">#374151</SolidColorBrush>
    <SolidColorBrush x:Key="BorderMediumGray">#4B5563</SolidColorBrush>
    <SolidColorBrush x:Key="HoverBackgroundGray">#374151</SolidColorBrush>
    <SolidColorBrush x:Key="ClickBackgroundBlue">#1E3A5F</SolidColorBrush>
    <SolidColorBrush x:Key="TextDarkGray">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="TextMediumGray">#D1D5DB</SolidColorBrush>
    <SolidColorBrush x:Key="TextBlack">#F9FAFB</SolidColorBrush>
    <SolidColorBrush x:Key="PriceBlue">#60A5FA</SolidColorBrush>
    <SolidColorBrush x:Key="PressedOverlay">#33FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TransparentBrush">Transparent</SolidColorBrush>

    <!-- Payment View Colors -->
    <SolidColorBrush x:Key="PaymentLeftPanelBackground">#1F2937</SolidColorBrush>
    <SolidColorBrush x:Key="PaymentInputBackground">#E8E8E8</SolidColorBrush>
    <SolidColorBrush x:Key="SuccessColor">#4CAF50</SolidColorBrush>
    <SolidColorBrush x:Key="InfoColor">#2196F3</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorColor">#F44336</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryButtonColor">#9E9E9E</SolidColorBrush>

</ResourceDictionary>
