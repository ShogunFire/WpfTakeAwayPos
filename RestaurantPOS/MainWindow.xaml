<Window x:Class="RestaurantPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:controls="clr-namespace:RestaurantPOS.Views.Controls"
        Title="Restaurant POS" 
        WindowState="Maximized"
        Background="{DynamicResource PageBackground}"
        Foreground="{DynamicResource TextBlack}"
        xmlns:views="clr-namespace:RestaurantPOS.Views" xmlns:vm="clr-namespace:RestaurantPOS.ViewModels">
    <Window.Resources>
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type vm:MainMenuViewModel}">
                <views:MainMenuView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                <views:InventoryView/>
            </DataTemplate>
       

            <DataTemplate DataType="{x:Type vm:OrderEntryViewModel}">
                <views:OrderEntryView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PaymentViewModel}">
                <views:PaymentView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CashControlViewModel}">
                <views:CashControlView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EndShiftViewModel}">
                <views:EndShiftPopupView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AddInventoryViewModel}">
                <views:AddInventoryPopupView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RemoveInventoryViewModel}">
                <views:RemoveInventoryPopupView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StepPopupViewModel}">
                <views:StepPopupView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CashFlowWizardViewModel}">
                <views:CashFlowStepContentView/>
            </DataTemplate>
       
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{DynamicResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo placeholder - you can replace with an actual logo image -->
                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource BackgroundWhite}" Margin="0,0,12,0">
                        <TextBlock Text="🐔" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextBlack}" />
                    </Border>
                    <TextBlock Text="Pollos Rancheros Nealtican" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextBlack}" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- End Shift Button -->
                <Button Grid.Column="1"
                        Content="🏁 End Shift"
                        Width="150"
                        Height="50"
                        Background="#FF6B3C"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,12,0"
                        Command="{Binding TopBar.EndShiftCommand}"/>

                <!-- Home Button -->
                <Button Grid.Column="2"
                        Visibility="{Binding TopBar.ShowHomeButton, Converter={StaticResource BoolToVisibilityConverter}}"
                        Width="50"
                        Height="50"
                        Background="{DynamicResource BackgroundWhite}"
                        Foreground="{DynamicResource TextBlack}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding TopBar.GoHomeCommand}">
                    <fa:IconBlock Icon="House" FontSize="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ContentControl Grid.Row="1" Content="{Binding NavigationService.CurrentViewModel}"/>

        <!-- Generic Popup Container -->
        <controls:PopupContainer Grid.RowSpan="2" 
                                  IsPopupOpen="{Binding PopupService.IsPopupOpen}"
                                  CurrentPopupViewModel="{Binding PopupService.CurrentPopupViewModel}"/>

        <!-- Global Dialog Box -->
        <controls:DialogBox x:Name="DialogBoxControl" Grid.RowSpan="2"/>
    </Grid>
</Window>