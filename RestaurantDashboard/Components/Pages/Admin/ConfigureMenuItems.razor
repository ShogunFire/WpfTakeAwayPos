@page "/configure/menu-items"
@using RestaurantDashboard.Data.Models
@using RestaurantDashboard.Data.Services
@inject IMasterDataAdminService AdminService
@inject NavigationManager Nav

<PageTitle>Menu Items</PageTitle>

<div class="list-page">
    <div class="list-page-header">
        <div>
            <h1>Menu Items</h1>
            <p>Filter by category, click an item to drill down, or use small action buttons to edit.</p>
        </div>
        <button class="btn-add" @onclick="OpenAdd">+ Add</button>
    </div>

    <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 10px; flex-wrap: wrap;">
        <div class="list-filter" style="margin-bottom: 0;">
            <input type="text" @bind="search" @bind:event="oninput" placeholder="🔍  Filter menu items…" />
        </div>
        <select @bind="selectedCategoryFilter" @bind:after="OnCategoryFilterChangedAsync"
                style="padding: 8px 10px; border: 1px solid #d1d5db; border-radius: 8px; background: white;">
            <option value="@Guid.Empty">All categories</option>
            @foreach (var cat in categories.Where(c => c.IsActive).OrderBy(c => c.Name))
            {
                <option value="@cat.Id">@cat.Name</option>
            }
        </select>
    </div>

    <div class="list-table-panel">
        @foreach (var item in FilteredItems.OrderBy(m => m.Name))
        {
            <div class="list-row" @onclick="() => OpenDetail(item)">
                <div class="list-row-main">
                    <strong>@item.Name</strong>
                    <span class="list-row-sub">
                        @GetCategoryName(item.IdCategory) • @(string.IsNullOrWhiteSpace(item.Description) ? "No description" : item.Description)
                    </span>
                </div>
                <div class="list-row-actions" @onclick:stopPropagation="true">
                    <span class="price-tag">$@item.Price.ToString("0.00")</span>
                    <span class="badge @(item.IsActive ? "badge-active" : "badge-inactive")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                    <button class="btn-icon" title="Edit" @onclick="() => OpenEdit(item)">✏️</button>
                </div>
            </div>
        }
        @if (!FilteredItems.Any() && !loading)
        {
            <div class="list-empty">No menu items found.</div>
        }
    </div>
</div>

<Modal IsVisible="modalOpen" Title="@modalTitle" OnClose="CloseModal">
    <div class="modal-form">
        <div>
            <label>Name</label>
            <input type="text" @bind="form.Name" placeholder="e.g. Classic Burger" />
        </div>
        <div>
            <label>Description</label>
            <input type="text" @bind="form.Description" placeholder="Optional" />
        </div>
        <div>
            <label>Category</label>
            <select @bind="form.IdCategory">
                <option value="@Guid.Empty">— Select category —</option>
                @foreach (var cat in categories.Where(c => c.IsActive).OrderBy(c => c.Name))
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>
        <div>
            <label>Price ($)</label>
            <input type="number" step="0.01" min="0" @bind="form.Price" />
        </div>
        <div>
            <label class="checkbox-label">
                <input type="checkbox" @bind="form.IsActive" /> Active
            </label>
        </div>
        @if (!string.IsNullOrWhiteSpace(formError))
        {
            <div class="modal-error">@formError</div>
        }
        <div class="modal-actions">
            <button class="btn-primary" @onclick="SaveAsync">Save</button>
            <button class="btn-secondary" @onclick="CloseModal">Cancel</button>
        </div>
    </div>
</Modal>

@code {
    [SupplyParameterFromQuery(Name = "categoryId")]
    public Guid? CategoryIdQuery { get; set; }

    private List<MasterMenuItem> items = new();
    private List<MasterCategory> categories = new();
    private MasterMenuItem form = new() { IsActive = true };
    private string search = string.Empty;
    private bool loading = true;
    private Guid selectedCategoryFilter = Guid.Empty;
    private bool modalOpen;
    private string modalTitle = string.Empty;
    private string formError = string.Empty;

    private IEnumerable<MasterMenuItem> FilteredItems =>
        items.Where(i =>
            (selectedCategoryFilter == Guid.Empty || i.IdCategory == selectedCategoryFilter) &&
            (string.IsNullOrWhiteSpace(search) || i.Name.Contains(search, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        if (CategoryIdQuery.HasValue)
        {
            selectedCategoryFilter = CategoryIdQuery.Value;
        }
    }

    protected override void OnParametersSet()
    {
        if (CategoryIdQuery.HasValue)
        {
            selectedCategoryFilter = CategoryIdQuery.Value;
        }
        else
        {
            selectedCategoryFilter = Guid.Empty;
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        items = await AdminService.GetMenuItemsAsync();
        categories = await AdminService.GetCategoriesAsync();
        loading = false;
    }

    private Task OnCategoryFilterChangedAsync()
    {
        if (selectedCategoryFilter == Guid.Empty)
        {
            Nav.NavigateTo("/configure/menu-items", replace: true);
        }
        else
        {
            Nav.NavigateTo($"/configure/menu-items?categoryId={selectedCategoryFilter}", replace: true);
        }

        return Task.CompletedTask;
    }

    private void OpenAdd()
    {
        form = new MasterMenuItem
        {
            IsActive = true,
            IdCategory = selectedCategoryFilter == Guid.Empty ? Guid.Empty : selectedCategoryFilter
        };
        modalTitle = "Add Menu Item";
        formError = string.Empty;
        modalOpen = true;
    }

    private void OpenEdit(MasterMenuItem item)
    {
        form = new MasterMenuItem
        {
            Id = item.Id,
            IdCategory = item.IdCategory,
            Name = item.Name,
            Description = item.Description,
            Price = item.Price,
            IsActive = item.IsActive
        };
        modalTitle = "Edit Menu Item";
        formError = string.Empty;
        modalOpen = true;
    }

    private void OpenDetail(MasterMenuItem item)
    {
        Nav.NavigateTo($"/configure/menu/{item.IdCategory}/{item.Id}");
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(form.Name))
        {
            formError = "Name is required.";
            return;
        }

        if (form.IdCategory == Guid.Empty)
        {
            formError = "Please select a category.";
            return;
        }

        if (form.Price < 0)
        {
            formError = "Price cannot be negative.";
            return;
        }

        if (form.Id == Guid.Empty)
        {
            await AdminService.CreateMenuItemAsync(form);
        }
        else
        {
            await AdminService.UpdateMenuItemAsync(form);
        }

        CloseModal();
        await LoadAsync();
    }

    private void CloseModal()
    {
        modalOpen = false;
        formError = string.Empty;
    }

    private string GetCategoryName(Guid id)
        => categories.FirstOrDefault(c => c.Id == id)?.Name ?? "—";
}
