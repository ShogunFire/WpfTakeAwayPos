@page "/menu"
@inject FakeDataService Data

<h3>Menu Management</h3>

@foreach (var cat in Data.Categories)
{
    <h4>@cat.Name</h4>

    @foreach (var item in Data.MenuItems.Where(m => m.CategoryId == cat.Id))
    {
        <div class="menu-item">
            <span>@item.Name</span>
            <span>@item.Price.ToString("C")</span>
            <input type="checkbox" checked="@item.IsActive" /> Active
        </div>
    }
}