@page "/orders"
@inject FakeDataService Data

<h3>Orders</h3>

<table>
    <thead>
        <tr>
            <th>#</th>
            <th>Date</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Data.Orders)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.OrderDate.ToShortDateString()</td>
                <td>@order.Amount.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>
