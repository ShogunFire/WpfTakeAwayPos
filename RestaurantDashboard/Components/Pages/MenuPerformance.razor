@page "/menu-performance"
@using RestaurantDashboard.Data.Services
@inject AnalyticsService Analytics
@rendermode InteractiveServer

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>Menu Performance</h1>
        <div class="filters">
            <select @bind="selectedLocationId" @bind:after="LoadDataAsync">
                <option value="">All Locations</option>
                @foreach (var location in locations)
                {
                    <option value="@location.Id">@location.Name</option>
                }
            </select>
            <input type="date" @bind="startDate" @bind:after="LoadDataAsync" />
            <span>to</span>
            <input type="date" @bind="endDate" @bind:after="LoadDataAsync" />
            <select @bind="sortBy" @bind:after="SortData">
                <option value="revenue">Sort by Revenue</option>
                <option value="quantity">Sort by Quantity</option>
                <option value="profit">Sort by Profit Margin</option>
            </select>
            <button class="btn-primary" @onclick="LoadDataAsync">Refresh</button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading">Loading...</div>
    }
    else
    {
        <div class="metrics-grid">
            <div class="metric-card">
                <div class="metric-label">Total Menu Items</div>
                <div class="metric-value">@menuData.Count</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Total Revenue</div>
                <div class="metric-value positive">$@totalRevenue.ToString("N2")</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Total Items Sold</div>
                <div class="metric-value">@totalQuantity.ToString("N0")</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Top Item</div>
                <div class="metric-value small">@topItem</div>
            </div>
        </div>

        @if (sortedMenuData.Any())
        {
            <div class="section">
                <h2>Top Performing Items</h2>
                <div class="chart-container">
                    <div class="horizontal-bar-chart">
                        @{
                            var topItems = sortedMenuData.Take(10);
                            var maxRevenue = topItems.Max(m => m.TotalRevenue);
                        }
                        @foreach (var item in topItems)
                        {
                            var percentage = maxRevenue > 0 ? (item.TotalRevenue / maxRevenue * 100) : 0;
                            <div class="horizontal-bar-wrapper">
                                <div class="item-label">@item.MenuItemName</div>
                                <div class="bar-container">
                                    <div class="horizontal-bar" style="width: @percentage%">
                                        <span class="bar-text">$@item.TotalRevenue.ToString("N2")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="section">
                <div class="section-header">
                    <h2>Menu Item Trend</h2>
                    <div class="section-filters">
                        <select @bind="selectedMenuItemId" @bind:after="LoadMenuItemTrendAsync">
                            <option value="">Select a menu item</option>
                            @foreach (var item in menuItems)
                            {
                                <option value="@item.MenuItemId">@item.MenuItemName</option>
                            }
                        </select>
                        <select @bind="trendInterval" @bind:after="LoadMenuItemTrendAsync">
                            <option value="day">Daily</option>
                            <option value="week">Weekly</option>
                            <option value="month">Monthly</option>
                        </select>
                    </div>
                </div>

                @if (menuItemTrend.Any())
                {
                    <div class="chart-container">
                        <svg class="line-chart" viewBox="0 0 1200 400" preserveAspectRatio="xMidYMid meet">
                            @{
                                var points = menuItemTrend.OrderBy(d => d.Period).ToList();
                                if (points.Any())
                                {
                                    var maxValue = Math.Max(
                                        Math.Max(points.Max(p => p.TotalRevenue), points.Max(p => p.TotalCost)),
                                        points.Max(p => p.TotalProfit)
                                    );
                                    var padding = 60;
                                    var chartWidth = 1200 - (padding * 2);
                                    var chartHeight = 400 - (padding * 2);
                                    var pointSpacing = chartWidth / (points.Count > 1 ? points.Count - 1 : 1);
                                    var yScale = chartHeight / (maxValue > 0 ? maxValue : 100);

                                    <g class="grid">
                                        @for (int i = 0; i <= 5; i++)
                                        {
                                            var yPos = padding + (i * chartHeight / 5);
                                            <line x1="@padding" y1="@yPos" x2="@(1200 - padding)" y2="@yPos" stroke="#e0e0e0" stroke-width="1"/>
                                        }
                                    </g>

                                    <polyline class="line revenue" points="@string.Join(" ", points.Select((p, i) =>
                                        $"{padding + (i * pointSpacing)},{padding + chartHeight - (p.TotalRevenue * yScale)}"))"/>

                                    <polyline class="line cost" points="@string.Join(" ", points.Select((p, i) =>
                                        $"{padding + (i * pointSpacing)},{padding + chartHeight - (p.TotalCost * yScale)}"))"/>

                                    <polyline class="line profit" points="@string.Join(" ", points.Select((p, i) =>
                                        $"{padding + (i * pointSpacing)},{padding + chartHeight - (p.TotalProfit * yScale)}"))"/>

                                    @foreach (var (p, i) in points.Select((p, i) => (p, i)))
                                    {
                                        var x = padding + (i * pointSpacing);
                                        var y = padding + chartHeight - (p.TotalRevenue * yScale);
                                        <circle class="point revenue" cx="@x" cy="@y" r="4"/>
                                    }

                                    @foreach (var (p, i) in points.Select((p, i) => (p, i)))
                                    {
                                        var x = padding + (i * pointSpacing);
                                        var y = padding + chartHeight - (p.TotalCost * yScale);
                                        <circle class="point cost" cx="@x" cy="@y" r="4"/>
                                    }

                                    @foreach (var (p, i) in points.Select((p, i) => (p, i)))
                                    {
                                        var x = padding + (i * pointSpacing);
                                        var y = padding + chartHeight - (p.TotalProfit * yScale);
                                        <circle class="point profit" cx="@x" cy="@y" r="4"/>
                                    }

                                    <line x1="@padding" y1="@padding" x2="@padding" y2="@(400 - padding)" stroke="#333" stroke-width="2"/>
                                    <line x1="@padding" y1="@(400 - padding)" x2="@(1200 - padding)" y2="@(400 - padding)" stroke="#333" stroke-width="2"/>
                                }
                            }
                        </svg>
                    </div>
                    <div class="chart-labels">
                        <div class="label-row">
                            @foreach (var data in menuItemTrend.OrderBy(d => d.Period))
                            {
                                <div class="period-label">@FormatPeriod(data.Period)</div>
                            }
                        </div>
                    </div>
                    <div class="legend">
                        <div class="legend-item">
                            <span class="legend-color revenue"></span>
                            <span>Revenue</span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-color cost"></span>
                            <span>Cost</span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-color profit"></span>
                            <span>Profit</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="no-data">No trend data found for the selected item.</div>
                }
            </div>

            <div class="section">
                <h2>Detailed Menu Performance</h2>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Item Name</th>
                                <th>Quantity Sold</th>
                                <th>Total Revenue</th>
                                <th>Avg Price</th>
                                <th>Avg Cost</th>
                                <th>Profit Margin</th>
                                <th>Revenue %</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in sortedMenuData)
                            {
                                var revenuePercent = totalRevenue > 0 ? (item.TotalRevenue / totalRevenue * 100) : 0;
                                <tr>
                                    <td><strong>@item.MenuItemName</strong></td>
                                    <td>@item.TotalQuantity.ToString("N0")</td>
                                    <td>$@item.TotalRevenue.ToString("N2")</td>
                                    <td>$@item.AveragePrice.ToString("N2")</td>
                                    <td>$@item.AverageCost.ToString("N2")</td>
                                    <td class="@(item.ProfitMargin >= 0 ? "positive" : "negative")">
                                        @item.ProfitMargin.ToString("N1")%
                                    </td>
                                    <td>
                                        <div class="progress-bar">
                                            <div class="progress-fill" style="width: @revenuePercent%"></div>
                                            <span class="progress-text">@revenuePercent.ToString("N1")%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="totals-row">
                                <td><strong>Total</strong></td>
                                <td><strong>@totalQuantity.ToString("N0")</strong></td>
                                <td><strong>$@totalRevenue.ToString("N2")</strong></td>
                                <td colspan="4"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="no-data">No menu performance data found for the selected period.</div>
        }
    }
</div>

<style>
    .dashboard-container {
        padding: 20px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .dashboard-header h1 {
        margin: 0;
        font-size: 28px;
    }

    .filters {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .filters select, .filters input {
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 4px;
