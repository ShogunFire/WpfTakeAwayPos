@page "/dashboard"
@rendermode InteractiveServer

<div class="dashboard-container">
    <div class="dashboard-topbar">
        <div class="dashboard-topbar-row">
            <h1 class="dashboard-title">Dashboard Overview</h1>
            <div class="dashboard-filters">
                <div class="dashboard-date-restaurant">
                    <input type="date" @bind="startDate" @bind:after="OnDateRangeChanged" />
                    <span>-</span>
                    <input type="date" @bind="endDate" @bind:after="OnDateRangeChanged" />
                    <select @bind="selectedRestaurant" @bind:after="OnRestaurantChanged">
                        <option value="">All Restaurants</option>
                        <option value="restaurant1">Restaurant 1</option>
                        <option value="restaurant2">Restaurant 2</option>
                        <option value="restaurant3">Restaurant 3</option>
                    </select>
                </div>
                <div class="dashboard-periods">
                    <button class="period-btn active">Day</button>
                    <button class="period-btn">Week</button>
                    <button class="period-btn">Month</button>
                    <button class="period-btn">Year</button>
                </div>
                <label class="compare-checkbox">
                    <input type="checkbox" />
                    <span>Compare to Last Period</span>
                </label>
            </div>
        </div>
        <div class="dashboard-metrics-row">
            <div class="metric-card metric-large">
                <div class="metric-label">Total Sales</div>
                <div class="metric-value">$@metrics?.TotalSales.ToString("N0")</div>
            </div>
            <div class="metric-card metric-large">
                <div class="metric-label">Total Orders</div>
                <div class="metric-value">@metrics?.TotalOrders.ToString("N0")</div>
            </div>
            <div class="metric-card metric-large">
                <div class="metric-label">Average Check</div>
                <div class="metric-value">$@metrics?.AverageCheck.ToString("N2")</div>
            </div>
            <div class="metric-card metric-large">
                <div class="metric-label">Sales Growth</div>
                <div class="metric-value metric-growth">+10.5%</div>
                <div class="metric-subtext">Excellent performance</div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading">Loading dashboard data...</div>
    }
    else if (metrics != null)
    {
        <!-- Charts Grid -->
        <div class="charts-grid">
            <div class="chart-card">
                <h2>Sales Over Time</h2>
                <p class="chart-subtitle">Total summary represented over the selected period.</p>
                <canvas id="salesChart"></canvas>
            </div>

            <div class="chart-card">
                <h2>Top 5 Selling Items</h2>
                <p class="chart-subtitle">Items contributing most to total sales.</p>
                <canvas id="topItemsChart"></canvas>
            </div>
        </div>
    }
</div>

@code {
    // Properties are defined in the code-behind Dashboard.razor.cs
}
